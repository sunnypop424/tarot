# 이 파일을 .env.local 로 복사해서 채우세요. .env.local 은 커밋되지 않습니다(.gitignore).
#
#   cp .env.example .env.local
#
# 주의: VITE_ 접두사가 붙은 변수만 클라이언트 번들에 들어갑니다.
# ANTHROPIC_API_KEY 에는 절대 VITE_ 를 붙이지 마세요 — 브라우저로 키가 내려갑니다.

# Claude API 키 — console.anthropic.com 에서 발급.
# 개발 서버 미들웨어(scripts/vite-ai.mjs)만 이 값을 읽습니다.
# 없으면 AI 리딩이 꺼진 채로 뜨고, 앱은 카드별 개별 해석으로 그대로 돌아갑니다.
ANTHROPIC_API_KEY=

# 리딩에 쓸 모델 (선택). 기본값은 claude-haiku-4-5.
# 품질이 모자라면 claude-sonnet-5 로 올리세요 — 가격 비교는 docs/BACKEND.md.
# ANTHROPIC_MODEL=claude-haiku-4-5

# ── Supabase ────────────────────────────────────────────────────
# Settings → API 에서 복사. 이게 없으면 앱은 localStorage 로 돕니다
# (그 상태에선 주최자가 고친 답변이 방문자에게 가지 않습니다).
VITE_SUPABASE_URL=
# anon(=public / publishable) 키만. service_role / secret 키는 절대 넣지 마세요 —
# RLS 를 통째로 무시하는 키라 브라우저에 내려가면 아무나 남의 슬롯을 만집니다.
VITE_SUPABASE_ANON_KEY=

# 씨앗 계정(owner@example.com 등)의 비밀번호 — 격리 검증 스크립트가 로그인해봅니다.
# node scripts/verify-supabase.mjs
SEED_PASSWORD=

# AI 서버 함수 주소 (Supabase Edge Function).
# 비워두면 개발 서버 미들웨어(/__ai)를 부르는데, 그건 이제 없습니다 — 채우세요.
#   https://<프로젝트ref>.supabase.co/functions/v1/ai
# 키(ANTHROPIC_API_KEY)는 여기가 아니라 함수 secret 으로만 삽니다:
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
VITE_AI_BASE=
